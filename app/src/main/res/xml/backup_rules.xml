<?xml version="1.0" encoding="utf-8"?>
<!-- Excluye todos los dominios de la copia de seguridad completa (API < 31). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
